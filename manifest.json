{
  "manifest_version": 3,
  "name": "1/2波片偏振分析与极坐标工作台",
  "short_name": "PLO Polar Studio",
  "version": "3.0.0",
  "description": "偏振与半波片旋转测量数据的可追溯预处理、独立周期统计、经验谐波拟合、质量门与科研报告工作台",
  "action": {
    "default_title": "点击直接打开 1/2波片偏振分析工作台 (全栏)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
